# =====================================================================
#  DeepDx Terraform Variables Example
#  Copy this file to "terraform.tfvars" and fill in your values:
#    cp terraform.tfvars.example terraform.tfvars
# =====================================================================

# AWS Region: Mumbai (ap-south-1)
aws_region   = "ap-south-1"
environment  = "production"
project_name = "deepdx"

# EC2 instance type (4th Gen Intel Xeon Sapphire Rapids, 8 GB RAM)
instance_type = "m7i-flex.large"

# Size of the root EBS volume in GiB
root_volume_size_gb = 30

# Path to the local model weights to upload to S3 (relative to terraform/ directory)
model_weights_path = "../models/best_model.weights.h5"

# Groq Cloud API Key for live clinical reasoning synthesis
groq_api_key = "gsk_your_groq_api_key_here"
groq_model   = "openai/gpt-oss-120b"

# Optional: Paste your public SSH key (e.g. "ssh-ed25519 AAAAC3NzaC1...") to SSH into EC2
# ssh_public_key = ""

# Git branch to clone on the server ("feature/phase-1" or "main" once merged)
git_branch = "feature/phase-1"

# Restrict SSH (Port 22) to your IP for security (e.g. "203.0.113.25/32")
allowed_ssh_cidr = "0.0.0.0/0"
