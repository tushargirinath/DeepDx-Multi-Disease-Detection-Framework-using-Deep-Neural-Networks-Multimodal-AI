# ============================================================
#  DeepDx Configuration Template
#  Copy this file to ".env" and fill in your values:
#    cp .env.example .env         (macOS / Linux)
#    copy .env.example .env       (Windows)
# ============================================================

# --- Groq Cloud (Primary Ultra-Fast LLM Reasoning) ---------
# Get your free/pro API key at https://console.groq.com/ (starts with "gsk_")
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Anthropic (Claude) — Optional Alternative -------------
# Get a key at https://console.anthropic.com/ (starts with "sk-ant-")
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-5

# --- OpenRouter — Optional Multi-Model Provider ------------
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free

# --- Model Files -------------------------------------------
# Path to your trained CNN weights (relative to project root).
CNN_WEIGHTS_PATH=models/best_model.weights.h5

# Path to the ordered list of 30 class names (see README).
CLASS_NAMES_PATH=class_names.json

# --- Contextual-Memory Sources -----------------------------
# Enable the real Microsoft BioGPT model (requires: uv sync --extra biogpt).
# If false, a curated biomedical-context fallback is used instead.
ENABLE_BIOGPT=false

# Med-PaLM 2 has no public API. This adapter is a labeled placeholder.
# Leave false unless you have wired real Google MedLM/Med-PaLM access.
ENABLE_MEDPALM=false

# --- Server ------------------------------------------------
HOST=0.0.0.0
PORT=8000
